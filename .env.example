# AI Time Machine Environment Variables
# Copy this file to .env.local and fill in your values

# Wikipedia API (No authentication required - uses public API)
NEXT_PUBLIC_WIKIPEDIA_ENABLED=true

# Wikimedia Commons API (No authentication required - uses public API)
NEXT_PUBLIC_WIKIMEDIA_ENABLED=true

# Historical Events API (Local database - no external API)
NEXT_PUBLIC_EVENTS_ENABLED=true

# Cache settings (in milliseconds)
NEXT_PUBLIC_CACHE_TTL=3600000
